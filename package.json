{
  "name": "employee-compensation-service",
  "version": "1.0.0",
  "private": true,
  "description": "HR employee and compensation API built on Azure Functions (TypeScript) and Azure SQL.",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "setup": "npm run build && node dist/scripts/setup.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "npm run build && node dist/scripts/db-setup.js",
    "deploy": "npm run build && node dist/scripts/deploy.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "mssql": "^12.7.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
