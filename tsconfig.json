{
  // Base config used by the editor, `npm run typecheck` and tests. Covers every TypeScript file.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // "nodenext" follows Node's own rules; with no "type": "module" in package.json the output is CommonJS.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Strict mode: the compiler refuses code that ignores a possible null (e.g. a NULL bonus).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
